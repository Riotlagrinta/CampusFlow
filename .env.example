# =============================================================================
# StudentHub - variables d'environnement
#
# Copier ce fichier en `.env.local` (développement) ou le saisir dans Vercel
# (Settings > Environment Variables, environnements Production ET Preview).
# Ne JAMAIS committer de vraies valeurs : seul ce fichier de placeholders est suivi par git.
#
# Criticité :
#   [CRITIQUE]    l'application ne démarre pas ou n'est pas sûre sans cette variable
#   [IMPORTANT]   une fonctionnalité majeure est désactivée ou dégradée sans elle
#   [OPTIONNEL]   confort, valeur de repli sûre ou usage ponctuel
# =============================================================================


# --- Base de données ---------------------------------------------------------

# [CRITIQUE] URL PostgreSQL (Neon). Utiliser l'URL "pooled" en production serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"


# --- Authentification --------------------------------------------------------

# [CRITIQUE] Secret de signature des sessions NextAuth ET des JWT mobiles (aucune valeur de repli).
# Générer avec : openssl rand -base64 32     (le faire tourner invalide toutes les sessions)
AUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# [INUTILISÉE] Ancien nom de l'URL du site : plus aucune lecture dans le code (NextAuth tourne en
# trustHost, le domaine vient de NEXT_PUBLIC_APP_URL). Inutile de la définir ; si elle existe déjà dans
# Vercel, elle peut être supprimée (ou laissée, sans effet).
# NEXTAUTH_URL="http://localhost:3000"

# [OPTIONNEL] Ancien nom d'AUTH_SECRET, accepté en repli UNIQUEMENT par src/proxy.ts (lecture du cookie de
# session). Si vous le définissez, il doit être identique à AUTH_SECRET ; préférer ne pas le définir.
# NEXTAUTH_SECRET=""


# --- URL de l'application ----------------------------------------------------

# [CRITIQUE] Domaine canonique (origine seule, sans slash final). Sert au CORS de /api/* (donc
# NÉCESSAIRE même quand les paiements sont désactivés), aux URL de retour de paiement et aux liens
# envoyés par email. Un seul domaine en production.
# Pour les paiements Genius Pay (si activés) : il n'y a plus de domaine de repli, et sans cette
# variable la création d'un paiement renvoie une erreur 503. Lue au build : redéployer après modification.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# [OPTIONNEL] Numéro WhatsApp de l'administrateur affiché dans la boutique, le support et la page
# "À propos" (format international, sans "+" ni espaces, ex. 22890000000).
# NEXT_PUBLIC_* : exposé au navigateur, ne pas y mettre de donnée privée.
# Peut rester ABSENT tant que les paiements sont désactivés (voir NEXT_PUBLIC_PAYMENTS_ENABLED).
NEXT_PUBLIC_ADMIN_WHATSAPP="22800000000"

# [OPTIONNEL] Numéros de paiement manuel affichés sur la page checkout (NEXT_PUBLIC_* : publics).
# Sans eux, la section "paiement manuel" est masquée.
# Peuvent rester ABSENTS tant que les paiements sont désactivés (voir NEXT_PUBLIC_PAYMENTS_ENABLED).
NEXT_PUBLIC_TMONEY_NUMBER="22800000000"
NEXT_PUBLIC_FLOOZ_NUMBER="22800000000"


# --- Intelligence artificielle ----------------------------------------------

# [IMPORTANT] Clé API Groq (assistant IA, flashcards, quiz, explications). Sans elle : IA indisponible.
GROQ_API_KEY="gsk_changeme"

# [OPTIONNEL] Modèles Groq essayés dans l'ordre (rotation en cas d'indisponibilité), identifiants séparés
# par des virgules. Sans cette variable, la liste par défaut de src/lib/ai.ts est utilisée. Utile pour
# remplacer un modèle déprécié par Groq sans modifier le code.
# AI_MODELS="openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b"

# [OPTIONNEL] Clé API Google (lecture publique de fichiers/dossiers Google Drive : import de
# ressources, génération de quiz depuis un PDF Drive). Restreindre la clé à l'API Drive.
GOOGLE_API_KEY="changeme"

# [OPTIONNEL] Clé API Tavily (recherche web de l'assistant). Sans elle : pas de recherche web.
TAVILY_API_KEY="tvly-changeme"


# --- Paiements : interrupteur et Genius Pay ----------------------------------

# [IMPORTANT] INTERRUPTEUR UNIQUE DES PAIEMENTS (boutique, achat de jetons, abonnements).
# DÉSACTIVÉ PAR DÉFAUT : les paiements ne s'ouvrent que si la valeur est exactement "true"
# (absente, vide, "false", "TRUE", "1"... = fermés). Fermés, l'application fonctionne en freemium :
#  - /shop, /shop/checkout, /shop/success et /subscribe redirigent vers l'accueil ;
#  - aucun lien, bouton, prix ou badge d'achat/d'abonnement n'est affiché (web et mobile) ;
#  - POST /api/payment/genius/create et POST /api/payment/manual-request répondent 503
#    { error, code: "payments_disabled" } sans rien écrire en base ni lire de clé ;
#  - le quota quotidien gratuit, les jetons bonus (publicité récompensée, parrainage) et l'espace
#    admin des transactions restent actifs ; une transaction déjà existante peut encore être réglée
#    (callback/verify Genius) ou approuvée par un administrateur.
# NEXT_PUBLIC_* : valeur intégrée au build (navigateur ET serveur) : redéployer après modification.
# Variable mobile équivalente : EXPO_PUBLIC_PAYMENTS_ENABLED (voir mobile/.env.example).
# Réversible sans toucher au code : passer à "true" (et définir les variables ci-dessous), redéployer.
NEXT_PUBLIC_PAYMENTS_ENABLED="false"

# [IMPORTANT seulement si NEXT_PUBLIC_PAYMENTS_ENABLED="true"] Clés Genius Pay. La clé secrète
# signe/vérifie le callback de paiement : si elle fuit, n'importe qui peut forger un paiement. Sans ces
# clés, le paiement en ligne est indisponible. Peuvent rester ABSENTES tant que les paiements sont
# désactivés (le build n'en dépend pas).
GENIUS_PAY_PUBLIC_KEY="changeme"
GENIUS_PAY_SECRET_KEY="changeme"


# --- Messagerie : email (Gmail) et WhatsApp (UltraMsg, optionnel) ------------

# MODE PAR DÉFAUT : « CODES PAR EMAIL SEUL ». Les codes de vérification (inscription, mot de passe
# oublié) partent UNIQUEMENT par email ; les pages et les messages de l'API l'annoncent comme tel.
# Le champ téléphone reste obligatoire à l'inscription (identifiant unique), mais aucun message n'y est envoyé.

# [CRITIQUE] Compte Gmail expéditeur et son mot de passe d'application (pas le mot de passe du
# compte : https://myaccount.google.com/apppasswords). SANS EUX PERSONNE NE PEUT S'INSCRIRE (le code
# d'activation ne part pas) ni réinitialiser son mot de passe : l'inscription est refusée (502) si
# aucun canal ne livre le code. Limites à connaître : un compte Gmail gratuit plafonne à environ 500
# messages par jour (≈ 2000 avec Google Workspace), au-delà Gmail bloque l'envoi ; et les emails d'un
# compte Gmail personnel peuvent être classés en spam (les étudiants doivent vérifier leurs courriers
# indésirables). Si l'affluence augmente, passer à un service d'envoi dédié.
GMAIL_USER="expediteur@example.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# [OPTIONNEL] Instance et jeton UltraMsg. DÉSACTIVÉ par défaut : tant que ces DEUX variables ne sont
# pas toutes deux définies et non vides, WhatsApp n'est jamais appelé (aucune tentative, aucun
# journal) et les codes partent par email seul. Les définir réactive l'envoi WhatsApp (en plus de
# l'email) et les messages passent à « par WhatsApp et par email », sans toucher au code.
# Leur absence est normale : ne pas les renseigner.
# WHATSAPP_INSTANCE_ID="instanceXXXXX"
# WHATSAPP_TOKEN="changeme"

# [OPTIONNEL] Numéro WhatsApp qui reçoit les alertes admin (paiements, demandes manuelles),
# format international sans "+". N'a d'effet que si WHATSAPP_INSTANCE_ID et WHATSAPP_TOKEN sont définis.
# ADMIN_WHATSAPP_PHONE="22800000000"

# [OPTIONNEL] Adresse email qui reçoit les alertes admin (inscriptions, paiements, signalements).
ADMIN_NOTIFICATION_EMAIL="admin@example.com"


# --- Calendrier académique ---------------------------------------------------

# [OPTIONNEL] Semestre en cours (1 ou 2), utilisé pour proposer les contenus du bon semestre (serveur ET
# navigateur : NEXT_PUBLIC_*, donc lue au build, redéployer après modification).
# Sans cette variable, il est déduit de la date : S1 de septembre à janvier, S2 de février à août.
# NEXT_PUBLIC_CURRENT_SEMESTER="1"
# Variante serveur seulement (même effet côté API, invisible du navigateur) ; NEXT_PUBLIC_CURRENT_SEMESTER
# est prioritaire et suffit : inutile de définir les deux.
# CURRENT_SEMESTER="1"


# --- Stockage de fichiers (Vercel Blob) --------------------------------------

# [IMPORTANT] Jeton Vercel Blob (upload des ressources et avatars). Créé automatiquement quand un
# Blob store est lié au projet Vercel. Sans lui, l'upload de fichiers est indisponible en production.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_changeme"


# --- En-têtes de sécurité ----------------------------------------------------

# [OPTIONNEL] "true" : la Content-Security-Policy complète est APPLIQUÉE (next.config.ts).
# Par défaut elle n'est émise qu'en "Report-Only" (violations journalisées dans la console du
# navigateur, rien n'est bloqué). À activer après avoir vérifié qu'aucune violation n'apparaît.
# Valeur lue au build : redéployer après modification.
CSP_ENFORCE="false"


# --- Seed de développement (prisma/seed.ts, refusé en production) -------------

# [OPTIONNEL] Comptes de démonstration créés par `npm run db:seed`. Sans ces variables, le seed ne
# crée que les badges et les quiz (aucun compte). Mots de passe : 12 caractères minimum.
SEED_ADMIN_EMAIL="admin.local@example.com"
SEED_ADMIN_PASSWORD="changeme-min-12-chars"
SEED_STUDENT_EMAIL="etudiant.local@example.com"
SEED_STUDENT_PASSWORD="changeme-min-12-chars"


# --- Application mobile (mobile/.env, hors de ce projet web) -----------------
# Variables EXPO_PUBLIC_* de l'application Expo (voir mobile/.env.example et mobile/src/config.ts) :
# EXPO_PUBLIC_API_URL="https://votre-domaine.vercel.app/api"
# EXPO_PUBLIC_PAYMENTS_ENABLED="false"   # interrupteur des paiements, désactivé par défaut ("true" pour l'ouvrir)
# EXPO_PUBLIC_ADMIN_WHATSAPP="22800000000"
# EXPO_PUBLIC_TMONEY_NUMBER="22800000000"
# EXPO_PUBLIC_FLOOZ_NUMBER="22800000000"
