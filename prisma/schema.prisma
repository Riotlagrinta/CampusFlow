// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {

  id              String         @id @default(uuid())

  email           String         @unique

  firstName       String?

  lastName        String?

  password        String

  role            String         @default("STUDENT")

  bio             String?        @db.Text

  image           String?        

  xp              Int            @default(0)

  level           Int            @default(1)

  streak          Int            @default(0)

  lastActive      DateTime       @default(now())

  aiBonusRequests Int            @default(0) 

  

    // Validation OTP et Récupération

  

    isActive        Boolean        @default(false)

  

    otpCode         String?

  

    resetCode       String?

  

    resetCodeExpires DateTime?

  

  

  

  // Nouveaux liens de filière

  fieldId         String?

  field           Field?         @relation(fields: [fieldId], references: [id])

  academicLevelId String?

  academicLevel   Level?         @relation(fields: [academicLevelId], references: [id])



  dailyAIUsages   DailyAIUsage[]

  personalSchedules PersonalSchedule[]

  badges          UserBadge[]

  questions       Question[]

  answers         Answer[]

    resources       Resource[]

    quizAttempts    QuizAttempt[]

    bookmarks       Bookmark[]

  }

  

  model Bookmark {

    userId     String

    user       User     @relation(fields: [userId], references: [id])

    resourceId String

    resource   Resource @relation(fields: [resourceId], references: [id])

    createdAt  DateTime @default(now())

  

    @@id([userId, resourceId])

  }

  

  model Field {

  

    id          String      @id @default(uuid())

  

    name        String      @unique // ex: Génie Logiciel

  

    code        String      @unique // ex: GL

  

    description String?

  

    users       User[]

  

    resources   Resource[]

  

    questions   Question[]

  

    subjects    Subject[]

  

    schedules   PersonalSchedule[]

  

    createdAt   DateTime    @default(now())

  

  }

  

  

  

  model Level {

  

    id          String      @id @default(uuid())

  

    name        String      // ex: Licence 1, BTS 2

  

    users       User[]

  

    resources   Resource[]

  

    questions   Question[]

  

    subjects    Subject[]

  

    schedules   PersonalSchedule[]

  

  }

  

  

  

  model Subject {

  

    id          String      @id @default(uuid())

  

    name        String      // ex: Algorithmique, Mathématiques

  

    code        String?     // ex: ALGO, MATH

  

    fieldId     String

  

    field       Field       @relation(fields: [fieldId], references: [id])

  

    levelId     String

  

    level       Level       @relation(fields: [levelId], references: [id])

  

    resources   Resource[]

  

    quizzes     Quiz[]

  

    schedules   PersonalSchedule[]

  

    createdAt   DateTime    @default(now())

  

  }

  

  

  

  model Badge {

  

    id          String      @id @default(uuid())

  

    slug        String      @unique

  

    name        String

  

    description String

  

    icon        String

  

    xpCost      Int         @default(0)

  

    users       UserBadge[]

  

  }

  

  

  

  model UserBadge {

  

    userId      String

  

    badgeId     String

  

    obtainedAt  DateTime @default(now())

  

    user        User     @relation(fields: [userId], references: [id])

  

    badge       Badge    @relation(fields: [badgeId], references: [id])

  

  

  

    @@id([userId, badgeId])

  

  }

  

  

  

  model Quiz {

  

    id          String         @id @default(uuid())

  

    title       String

  

    description String?

  

    subjectName String?        // Garder pour compatibilité ou supprimer après migration

  

    subjectId   String?

  

    subject     Subject?       @relation(fields: [subjectId], references: [id])

  

    questions   QuizQuestion[]

  

    attempts    QuizAttempt[]

  

    xpReward    Int            @default(100)

  

      resourceId  String?        // Lien vers le PDF d'origine

  

      resource    Resource?      @relation(fields: [resourceId], references: [id])

  

      createdAt   DateTime       @default(now())

  

    }

  

  

  

  model QuizQuestion {

  

    id        String   @id @default(uuid())

  

    question  String

  

    options   String   // JSON stringified array of options

  

    answer    Int      // Index de la bonne réponse

  

    quizId    String

  

    quiz      Quiz     @relation(fields: [quizId], references: [id])

  

  }

  

  

  

  model QuizAttempt {

  

    id        String   @id @default(uuid())

  

    userId    String

  

    user      User     @relation(fields: [userId], references: [id])

  

    quizId    String

  

    quiz      Quiz     @relation(fields: [quizId], references: [id])

  

    score     Int      // Score en %

  

    xpGained  Int

  

    createdAt DateTime @default(now())

  

  }

  

  

  

  model DailyAIUsage {

  

    id           String   @id @default(uuid())

  

    userId       String

  

    user         User     @relation(fields: [userId], references: [id])

  

    date         DateTime @default(now()) 

  

    requestCount Int      @default(0)

  

    quizRequestCount Int  @default(0)

  

    tokensUsed   Int      @default(0)

  

  

  

    @@unique([userId, date]) 

  

  }

  

  

  

  model Question {

  

    id        String   @id @default(uuid())

  

    title     String

  

    content   String

  

    authorId  String

  

    author    User     @relation(fields: [authorId], references: [id])

  

    

  

    // Isolation par filière

  

    fieldId   String?

  

    field     Field?   @relation(fields: [fieldId], references: [id])

  

    levelId   String?

  

    level     Level?   @relation(fields: [levelId], references: [id])

  

  

  

    createdAt DateTime @default(now())

  

    answers   Answer[]

  

    tags      String?

  

  }

  

  

  

  model Answer {

  

    id         String   @id @default(uuid())

  

    content    String

  

    questionId String

  

    question   Question @relation(fields: [questionId], references: [id])

  

    authorId   String

  

    author     User     @relation(fields: [authorId], references: [id])

  

    createdAt  DateTime @default(now())

  

    isAccepted Boolean  @default(false)

  

  }

  

  

  

  model Resource {

  

    id          String   @id @default(uuid())

  

    title       String

  

    description String?

  

    type        String   // "PDF", "VIDEO", "AUDIO", "OTHER"

  

    url         String

  

    subjectName String?  // Garder subjectName pour l'instant

  

    subjectId   String?

  

    subject     Subject? @relation(fields: [subjectId], references: [id])

  

    authorId    String

  

    author      User     @relation(fields: [authorId], references: [id])

  

    

  

    // Isolation par filière

  

    fieldId     String?

  

    field       Field?   @relation(fields: [fieldId], references: [id])

  

    levelId     String?

  

    level       Level?   @relation(fields: [levelId], references: [id])

  

  

  

      createdAt   DateTime @default(now())

  

  

  

          size        String?

  

  

  

      

  

  

  

          // Gestion des dossiers

  

  

  

          parentId    String?

  

  

  

          parent      Resource? @relation("FolderContents", fields: [parentId], references: [id], onDelete: Cascade)

  

  

  

          children    Resource[] @relation("FolderContents")

  

  

  

      

  

  

  

          quizzes     Quiz[]

  

  

  

      bookmarks   Bookmark[]

  

  

  

    }

  

  

  

  model PersonalSchedule {

  

  

  

    id          String    @id @default(uuid())

  

  

  

    userId      String?

  

  

  

    user        User?     @relation(fields: [userId], references: [id])

  

  

  

    day         String

  

  

  

    time        String

  

  

  

    subjectName String?   // Rendu optionnel pour la migration

  

  

  

    subjectId   String?

  

  

  

    subject     Subject?  @relation(fields: [subjectId], references: [id])

  

    credits     String?

  

    teacher     String?

  

    type        String?

  

    isAcademic  Boolean   @default(false)

  

  

  

    // Lien filière pour les cours académiques

  

    fieldId     String?

  

    field       Field?    @relation(fields: [fieldId], references: [id])

  

    levelId     String?

  

    level       Level?    @relation(fields: [levelId], references: [id])

  

  

  

      createdAt   DateTime  @default(now())

  

  

  

      updatedAt   DateTime  @updatedAt

  

  

  

    }

  

  

  

    

  

  

  

    model SearchCache {

  

  

  

      id        String   @id @default(uuid())

  

  

  

      query     String   @unique

  

  

  

      result    String   @db.Text

  

  

  

      createdAt DateTime @default(now())

  

  

  

    }


